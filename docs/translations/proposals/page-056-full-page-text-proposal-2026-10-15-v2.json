    {
      "blockId": "block_100",
      "blockIndex": 32,
      "spanKey": "page_56_block_32__pt-BR",
      "sourceText": "Combatants of the same type might also have two or more Combatant Cards representing additional Groups. Each additional Group has ascending Activation Numbers and their own matching Initiative Card.",
      "proposalText": "Combatentes do mesmo tipo podem ter várias Cartas de Combatente, uma para cada Grupo. Cada Grupo adicional tem Números de Ativação consecutivos e sua própria Carta de Iniciativa.",
      "lineHeight": 1.1,
      "candidate": {
        "spanKey": "page_56_block_32__pt-BR",
        "language": "pt-BR",
        "data": {
          "schemaVersion": 2,
          "spanKey": "page_56_block_32__pt-BR",
          "bbox": [
            415.8424987792969,

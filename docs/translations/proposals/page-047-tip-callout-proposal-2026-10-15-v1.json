      "lineHeight": 1.1,
      "sourceLeadingPt": 11.0,
      "sourceFontSizePt": 10.0,
      "sourceLineCount": 6,
      "segments": [
        { "text": "Com o Aprimoramento de Item ", "font": "OptimaLTStd", "size": 10, "color": "#231f20", "weight": 400, "style": "normal", "disableLigatures": true },

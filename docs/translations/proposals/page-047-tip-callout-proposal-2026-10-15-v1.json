        { "text": ", um Aventureiro pode somar ", "font": "OptimaLTStd", "size": 10, "color": "#231f20", "weight": 400, "style": "normal", "disableLigatures": true },
        { "text": "+1 à rolagem de Ataque", "font": "OptimaLTStd-Bold", "size": 9, "color": "#231f20", "weight": 700, "style": "normal", "disableLigatures": true },
        { "text": " em qualquer momento do Ataque, escolhendo a hora mais vantajosa para ele. Assim, ele pode Exaurir esta carta para acrescentar o bônus ", "font": "OptimaLTStd", "size": 10, "color": "#231f20", "weight": 400, "style": "normal", "disableLigatures": true },
        { "text": "depois", "font": "OptimaLTStd-Bold", "size": 10, "color": "#231f20", "weight": 700, "style": "normal", "disableLigatures": true },

              "verticalAlignEm": -0.198260498046875
            }
          },
          {
            "text": " não podem ser ocupadas nem atravessadas. Uma miniatura ",
            "font": "OptimaLTStd",
            "size": 10,
            "color": "#231f20",
            "weight": 400,
            "style": "normal"
